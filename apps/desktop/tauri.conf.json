{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muesli",
  "identifier": "com.github.bdhoine.muesli",
  "build": { "frontendDist": "../../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "On-device meeting transcription",
    "macOS": { "minimumSystemVersion": "14.4", "infoPlist": "Info.plist", "entitlements": "Entitlements.plist" }
  }
}
